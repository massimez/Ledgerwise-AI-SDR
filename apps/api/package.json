{
  "name": "@workspace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./config": {
      "types": "./src/lib/app-config.ts",
      "import": "./src/lib/app-config.ts"
    },
    "./hc": {
      "types": "./src/lib/hc/hc.ts",
      "import": "./src/lib/hc/hc.ts"
    },
    "./logger": {
      "types": "./src/lib/logger.ts",
      "import": "./src/lib/logger.ts"
    },
    "./permissions": {
      "types": "./src/lib/auth/permissions.ts",
      "import": "./src/lib/auth/permissions.ts"
    },
    "./queues": {
      "types": "./src/lib/queues.ts",
      "import": "./src/lib/queues.ts"
    },
    "./sdr-inbound": {
      "types": "./src/modules/sdr/threads/inbound-executor.ts",
      "import": "./src/modules/sdr/threads/inbound-executor.ts"
    },
    "./sdr-shared": {
      "types": "./src/modules/sdr/shared/sdr.repository.ts",
      "import": "./src/modules/sdr/shared/sdr.repository.ts"
    },
    "./storage": {
      "types": "./src/modules/storage/config.ts",
      "import": "./src/modules/storage/config.ts"
    }
  },
  "main": "src/index.ts",
  "scripts": {
    "check-types": "tsc --noEmit",
    "dev": "bun --env-file=../../.env --hot src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@mastra/ai-sdk": "catalog:",
    "@mastra/core": "catalog:",
    "@workspace/ai-core": "workspace:*",
    "@workspace/db": "workspace:*",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "ioredis": "catalog:",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
