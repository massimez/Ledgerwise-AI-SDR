{
  "name": "@workspace/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts"
    },
    "./schema/*": {
      "types": "./src/schema/*.ts",
      "import": "./src/schema/*.ts"
    },
    "./sdr-defaults": {
      "types": "./src/sdr-defaults.ts",
      "import": "./src/sdr-defaults.ts"
    },
    "./seed": {
      "types": "./src/seed-data.ts",
      "import": "./src/seed-data.ts"
    }
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "bun --env-file=../../.env ./node_modules/.bin/drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env ./node_modules/.bin/drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env ./node_modules/.bin/drizzle-kit push",
    "db:seed": "bun --env-file=../../.env src/seed.ts",
    "db:studio": "bun --env-file=../../.env ./node_modules/.bin/drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
